import java.util.Scanner;
import java.util.ArrayList;
import java.util.Comparator;

public class Main{
    public static void main(String[] args){
        Scanner userInput = new Scanner (System.in);
        ArrayList <Integer> dNumbers = new ArrayList <Integer> ();
        int dOption = 0;
        int dMaximum = 0;
        int dMinimum = 0;
        int dSum = 0;
        float fAverage = 0;
        do{
            System.out.printf ("%s\n%s\n%s\n%s\n%s", 
                "1. Add number", 
                "2. Remove number",
                "3. Display numbers",
                "4. Exit",
                "Selection: ");
            dOption = userInput.nextInt();
            switch (dOption){
                case 1:
                    System.out.printf ("Enter the %d number:", dNumbers.size() + 1);
                    dNumbers.add(userInput.nextInt());
                    dNumbers.sort(Comparator.naturalOrder());
                    System.out.println("Number added successfully.");
                    break;
                case 2:
                    System.out.println(dNumbers.toString());
                    System.out.print ("Enter the number you want to remove: ");
                    dNumbers.remove (dNumbers.indexOf(userInput.nextInt()));
                    System.out.println (dNumbers.toString());
                    dNumbers.sort(Comparator.naturalOrder());
                    System.out.println("Number removed successfully.");
                    break;
                case 3:
                    dSum = 0;
                    dMinimum = dNumbers.get(0);
                    dMaximum = dNumbers.get(dNumbers.size() - 1);
                    for (int numbers : dNumbers){
                        dSum += numbers;
                    }
                    fAverage = (float)(dSum / dNumbers.size());
                    System.out.println (dNumbers.toString());
                    System.out.printf ("Minimum: %d\nMaximum: %d\nSum: %d\nAverage: %.2f\n", dMinimum, dMaximum, dSum, fAverage);
                    break;
                case 4:
                    System.out.println("Exiting program...");
                    break;
                default:
                    System.out.println("Out out range option");
                    break;
            }
        }while (dOption != 4);
        userInput.close();
    }
}
